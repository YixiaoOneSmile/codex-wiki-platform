NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4100
WEB_ORIGIN=https://assistant.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL_DOCKER=postgres://codex:URL_ENCODED_PASSWORD@postgres:5432/codex_wiki
SESSION_SECRET=replace-with-at-least-32-random-characters
AGENT_PROXY_TOKEN=replace-with-a-different-32-character-random-token
AGENT_SHELL_ENABLED=false
DATA_ROOT=/data/orgs
CODEX_HOME=/data/codex-home
CODEX_BIN=codex
DEEPSEEK_API_KEY=replace-in-server-secret-store
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_INPUT_PRICE_PER_MILLION=0.14
DEEPSEEK_CACHED_INPUT_PRICE_PER_MILLION=0.0028
DEEPSEEK_OUTPUT_PRICE_PER_MILLION=0.28
APP_TIMEZONE=Asia/Shanghai
CRAWL4AI_URL=http://crawl4ai:11235
CRAWL4AI_API_TOKEN=replace-with-a-different-32-character-random-token
CRAWL4AI_SECRET_KEY=replace-with-another-32-character-random-secret
CRAWL4AI_TIMEOUT_MS=180000
SCHEDULER_POLL_MS=10000
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_DISPLAY_NAME=平台管理员
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-12-plus-character-password
BOOTSTRAP_ORG_SLUG=default
BOOTSTRAP_ORG_NAME=我的智能助手
LOG_LEVEL=info
