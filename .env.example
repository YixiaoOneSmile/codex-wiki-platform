NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4100
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://codex:codex_local_only@127.0.0.1:5438/codex_wiki
DATABASE_URL_DOCKER=postgres://codex:codex_local_only@postgres:5432/codex_wiki
POSTGRES_PASSWORD=codex_local_only
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_ROOT=./runtime/orgs
CODEX_HOME=./runtime/codex-home
CODEX_BIN=codex
AGENT_PROXY_TOKEN=replace-with-a-separate-32-character-internal-token
AGENT_SHELL_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# USD per million tokens; verify current values before production.
DEEPSEEK_INPUT_PRICE_PER_MILLION=0.14
DEEPSEEK_CACHED_INPUT_PRICE_PER_MILLION=0.0028
DEEPSEEK_OUTPUT_PRICE_PER_MILLION=0.28
APP_TIMEZONE=Asia/Shanghai
CRAWL4AI_URL=http://crawl4ai:11235
# Production should use a separate random token. When omitted, AGENT_PROXY_TOKEN is used internally.
CRAWL4AI_API_TOKEN=
CRAWL4AI_SECRET_KEY=
CRAWL4AI_TIMEOUT_MS=180000
SCHEDULER_POLL_MS=10000
LOG_LEVEL=info
